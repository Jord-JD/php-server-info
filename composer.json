{
  "name": "jord-jd/php-server-info",
  "description": "Gets metrics on a server via an SSH connection",
  "type": "library",
  "require": {
    "php": ">=7.1",
    "jord-jd/php-ssh-connection": "^3.0||^4.0"
  },
  "license": "LGPL-3.0-only",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "autoload": {
    "psr-4": {
      "JordJD\\ServerInfo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JordJD\\ServerInfo\\Tests\\": "tests/"
    }
  },
  "replace": {
    "divineomega/php-server-info": "self.version"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "4.0-dev"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^7.5||^9.6||^10.5||^11.5||^12.5"
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": false
    }
  }
}
